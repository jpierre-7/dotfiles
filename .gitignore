# Device-local fish state. Fish rewrites this at runtime and it contains
# absolute, machine-specific paths, so it is kept out of version control for
# the same reason as the Noctalia local state file (see README).
fish/.config/fish/fish_variables

# herdr runtime state (not config)
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/release-notes.json

# Skills claude.ai syncs down at runtime; Claude Code manages these itself
claude/.claude/skills/synced/

# Per-machine link to niri/.config/niri/hosts/<hostname>.kdl, made by bootstrap.sh
niri/.config/niri/host.kdl
